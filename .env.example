# ==============================================================================
# 🚀 ZIBONBABA.COM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Duplicate this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE CLOUD
# ------------------------------------------------------------------------------
# Transaction Pooler (Port 6543) - Used by Next.js Serverless runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database Connection (Port 5432) - Used by Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# 64-character random string (e.g. generate via: openssl rand -base64 48)
JWT_SECRET="your-64-character-random-jwt-secret"
ZIBONBABA_API_ID="your-platform-api-id"

# ------------------------------------------------------------------------------
# 3. DOMAINS, APIS & NETWORKING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="https://zibonbaba.vercel.app"
NEXT_PUBLIC_APP_URL="https://zibonbaba.vercel.app"
NEXT_PUBLIC_API_URL="/api"
# NEXT_PUBLIC_WS_URL="wss://your-backend.railway.app"

PORT=3000
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATIONS
# ------------------------------------------------------------------------------
PAYMENT_SANDBOX="true"
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASS="your_sslcommerz_store_password"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL SMS & EMAIL COMMUNICATION
# ------------------------------------------------------------------------------
EMAIL_FROM="Zibonbaba <no-reply@zibonbaba.com>"
RESEND_API_KEY="re_your_resend_api_key"
SENDGRID_API_KEY="SG.your_sendgrid_api_key"

# Greenweb Bangladesh SMS Gateway
GREENWEB_SMS_TOKEN="your_greenweb_sms_token"

# Twilio SMS Gateway (Optional)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="your_twilio_from_number"

# ------------------------------------------------------------------------------
# 6. OPTIONAL BACKEND MICROSERVICE
# ------------------------------------------------------------------------------
# BACKEND_URL="http://localhost:5000"
